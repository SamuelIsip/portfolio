---
/*
 * The whole single page for one locale. Every route (/, /en/, /ro/) renders this,
 * so sections are added here once and appear in all languages.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/sections/Header.astro';
import Hero from '@/components/sections/Hero.astro';
import type { Locale } from '@/i18n/config';
import { pick } from '@/i18n/ui';
import { site } from '@/data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout
  locale={locale}
  title={pick(site.seo.title, locale)}
  description={pick(site.seo.description, locale)}
>
  <Header locale={locale} />
  <main id="main">
    <Hero locale={locale} />
  </main>
</BaseLayout>
