---
/*
 * The whole single page for one locale. Every route (/, /en/, /ro/) renders this,
 * so sections are added here once and appear in all languages.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import About from '@/components/sections/About.astro';
import Contact from '@/components/sections/Contact.astro';
import Experience from '@/components/sections/Experience.astro';
import Footer from '@/components/sections/Footer.astro';
import Header from '@/components/sections/Header.astro';
import Hero from '@/components/sections/Hero.astro';
import Projects from '@/components/sections/Projects.astro';
import Skills from '@/components/sections/Skills.astro';
import Landscape from '@/components/ui/Landscape.astro';
import type { Locale } from '@/i18n/config';
import { pick } from '@/i18n/ui';
import { site } from '@/data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout
  locale={locale}
  title={pick(site.seo.title, locale)}
  description={pick(site.seo.description, locale)}
>
  <Header locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <About locale={locale} />
    <Skills locale={locale} />
    <Projects locale={locale} />
    <Experience locale={locale} />
    <Contact locale={locale} />
  </main>
  <!-- The page ends where it began: back in the fields of La Mancha, with the footer on the ground. -->
  <Landscape class="mt-(--spacing-section) block h-40 w-full sm:h-56" />
  <Footer locale={locale} />
</BaseLayout>

<script>
  import '@/scripts/reveal';
</script>
