---
import { Image } from 'astro:assets';
import portrait from '@/assets/portrait.png';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Topography from '@/components/ui/Topography.astro';
import { site } from '@/data/site';
import type { Locale } from '@/i18n/config';
import { pick, useTranslations } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const [firstName, ...rest] = site.name.split(' ');
const nameLines = [firstName, rest.join(' ')];
const role = pick(site.role, locale);
const phrases = [role, ...pick(site.roleRotation, locale)];
---

<section aria-labelledby="hero-title" class="relative isolate overflow-hidden">
  <Topography fade="both" class="absolute inset-0 -z-10 size-full" />

  <!-- .page is content-box, so min-height subtracts the header (5rem) and this block's own padding (4rem + 3rem). -->
  <div class="page relative flex flex-col pt-10 pb-12 sm:pt-16 md:static lg:min-h-[min(calc(100svh-12rem),46rem)] lg:pt-16">
    <div class="md:max-w-[56%] lg:max-w-[58%]">
      <h1 id="hero-title" class="text-display font-bold tracking-(--tracking-display)">
        {
          nameLines.map((line, i) => (
            <span class="name-line block overflow-hidden pb-[0.12em] -mb-[0.12em]">
              <span style={`--i: ${i}`}>{line}</span>
            </span>
          ))
        }
      </h1>

      <!-- Screen readers get the plain role; the typing loop is visual only. -->
      <p data-enter style="--i: 2" class="font-display mt-5 text-xl font-medium whitespace-nowrap text-ink lg:text-2xl">
        <span class="sr-only">{role}</span>
        <span aria-hidden="true" data-typewriter data-phrases={JSON.stringify(phrases)}>{role}</span><span
          aria-hidden="true"
          class="caret ml-1 inline-block h-[0.95em] w-0.5 translate-y-[0.12em] bg-accent"></span>
      </p>

      <p data-enter style="--i: 3" class="mt-5 max-w-(--container-prose) text-lg text-muted">
        {pick(site.headline, locale)}
      </p>

      <div data-enter style="--i: 4" class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-2">
        <Button href="#projects">{t('hero.cta')}</Button>
        <Button href={pick(site.cv, locale)} variant="quiet" type="application/pdf" download>
          <Icon name="download" class="size-4" />
          {t('hero.cv')}
        </Button>
      </div>
    </div>

    <div data-enter style="--i: 5" class="mt-12 md:max-w-[56%] lg:mt-auto lg:max-w-[55%] lg:pt-16">
      <p class="text-sm text-muted">{t('hero.clients')}</p>
      <ul class="font-display mt-2 flex flex-wrap gap-x-6 gap-y-1 text-lg font-semibold tracking-(--tracking-tight) text-ink sm:gap-x-8 sm:text-xl">
        {site.clients.map((client) => <li>{client}</li>)}
      </ul>
    </div>

    <!--
      Phones: faint, behind the text, so the photo is visible on first load without scrolling.
      md+: full opacity, pinned to the right edge of the section.
    -->
    <!--
      Phones dim the photo with this filter rather than `opacity`: it lays the faded photo over
      a solid night silhouette, so the contour lines stay behind the photo instead of showing through.
    -->
    <svg class="absolute size-0" aria-hidden="true" focusable="false">
      <filter id="portrait-dim" color-interpolation-filters="sRGB">
        <feFlood style="flood-color: var(--color-night)" />
        <feComposite in2="SourceAlpha" operator="in" result="silhouette" />
        <feComponentTransfer in="SourceGraphic" result="faded">
          <feFuncA type="linear" slope="0.25" />
        </feComponentTransfer>
        <feMerge>
          <feMergeNode in="silhouette" />
          <feMergeNode in="faded" />
        </feMerge>
      </filter>
    </svg>
    <div
      class="portrait absolute top-6 right-0 -z-10 w-[88%] max-w-md md:top-auto md:bottom-0 md:z-auto md:h-[min(60%,34rem)] md:w-auto md:max-w-none lg:h-[min(74%,42rem)]"
    >
      <Image
        src={portrait}
        alt={t('hero.portraitAlt')}
        widths={[320, 480, 640, 880, 1100]}
        sizes="(min-width: 1024px) 34vw, (min-width: 768px) 44vw, 88vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="portrait-photo block h-auto w-full md:h-full md:w-auto"
      />
    </div>
  </div>
</section>

<script>
  import '@/scripts/typewriter';
</script>

<style>
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  @keyframes line-up {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* One orchestrated entrance: name lines slide up from their baseline, the rest follows. */
  .name-line > span {
    display: inline-block;
    animation: line-up 900ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 110ms + 100ms);
  }
  [data-enter] {
    animation: rise var(--duration-slow) var(--ease-out) both;
    animation-delay: calc(var(--i) * 90ms + 150ms);
  }
  .caret {
    animation: blink 1s steps(1) infinite;
  }
  .portrait {
    animation: rise 1100ms var(--ease-out) 300ms both;
    /* Phones: fade out early so the lower text sits on plain background. */
    mask-image: linear-gradient(to bottom, #000 40%, transparent 88%);
  }
  @media (max-width: 47.99rem) {
    .portrait-photo {
      filter: url(#portrait-dim);
    }
  }
  @media (min-width: 48rem) {
    .portrait {
      /* Melt the cut-off torso into the field instead of ending on a hard edge. */
      mask-image: linear-gradient(to bottom, #000 78%, transparent 99%);
    }
  }
</style>
