---
import { Image } from 'astro:assets';
import portrait from '@/assets/portrait.png';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Landscape from '@/components/ui/Landscape.astro';
import { site } from '@/data/site';
import type { Locale } from '@/i18n/config';
import { pick, useTranslations } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const [firstName, ...rest] = site.name.split(' ');
const nameLines = [firstName, rest.join(' ')];
---

<section aria-labelledby="hero-title" class="relative isolate overflow-hidden">
  <Landscape class="absolute inset-x-0 bottom-0 -z-10 h-64 w-full sm:h-80 lg:h-[46%]" />

  <!-- .page is content-box, so min-height subtracts the header (5rem) and this block's own padding (4rem + 3rem). -->
  <div class="page relative flex flex-col pt-10 sm:pt-16 md:static md:pb-12 lg:min-h-[min(calc(100svh-12rem),46rem)] lg:pt-16 lg:pb-12">
    <div class="md:max-w-[56%] lg:max-w-[58%]">
      <p data-enter style="--i: 0" class="font-display flex items-start gap-3 text-sm text-muted">
        <span class="mt-[0.7em] h-px w-6 shrink-0 bg-accent" aria-hidden="true"></span>
        {pick(site.availability, locale)}
      </p>

      <h1
        id="hero-title"
        class="mt-6 text-display font-bold tracking-(--tracking-display)"
      >
        {
          nameLines.map((line, i) => (
            <span class="name-line block overflow-hidden pb-[0.12em] -mb-[0.12em]">
              <span style={`--i: ${i}`}>{line}</span>
            </span>
          ))
        }
      </h1>

      <p data-enter style="--i: 2" class="font-display mt-5 text-xl font-medium text-ink lg:text-2xl">
        {pick(site.role, locale)}
      </p>

      <p data-enter style="--i: 3" class="mt-5 max-w-(--container-prose) text-lg text-muted">
        {pick(site.headline, locale)}
      </p>

      <div data-enter style="--i: 4" class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-2">
        <Button href="#projects">{t('hero.cta')}</Button>
        <Button href={pick(site.cv, locale)} variant="quiet" type="application/pdf" download>
          <Icon name="download" class="size-4" />
          {t('hero.cv')}
        </Button>
      </div>
    </div>

    <div data-enter style="--i: 5" class="mt-12 md:max-w-[56%] lg:mt-auto lg:max-w-[55%] lg:pt-16">
      <p class="text-sm text-muted">{t('hero.clients')}</p>
      <ul class="font-display mt-2 flex flex-wrap gap-x-6 gap-y-1 text-lg font-semibold sm:gap-x-8 sm:text-xl tracking-(--tracking-tight) text-ink">
        {site.clients.map((client) => <li>{client}</li>)}
      </ul>
    </div>

    <!-- Phones: the portrait closes the hero, standing in the field. md+: pinned to the right edge. -->
    <div
      class="portrait relative -mr-(--spacing-gutter) mt-4 ml-auto w-[64%] max-w-80 md:absolute md:right-0 md:bottom-0 md:mr-0 md:h-[min(60%,34rem)] md:w-auto md:max-w-none lg:h-[min(74%,42rem)]"
    >
      <Image
        src={portrait}
        alt={t('hero.portraitAlt')}
        widths={[320, 480, 640, 880, 1100]}
        sizes="(min-width: 1024px) 34vw, (min-width: 768px) 44vw, 64vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="block h-auto w-full md:h-full md:w-auto"
      />
    </div>
  </div>
</section>

<style>
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  @keyframes line-up {
    from {
      transform: translateY(105%);
    }
  }

  /* One orchestrated entrance: name lines slide up from their baseline, the rest follows. */
  .name-line > span {
    display: inline-block;
    animation: line-up 900ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 110ms + 100ms);
  }
  [data-enter] {
    animation: rise var(--duration-slow) var(--ease-out) both;
    animation-delay: calc(var(--i) * 90ms + 150ms);
  }
  .portrait {
    animation: rise 1100ms var(--ease-out) 300ms both;
    /* Melt the cut-off torso into the field instead of ending on a hard edge. */
    mask-image: linear-gradient(to bottom, #000 78%, transparent 99%);
  }
</style>
