---
import Section from '@/components/ui/Section.astro';
import { site } from '@/data/site';
import type { Locale } from '@/i18n/config';
import { pick, useTranslations } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const facts = [
  { term: t('about.location'), value: site.location },
  { term: t('about.experience'), value: t('about.years').replace('{n}', String(site.experienceYears)) },
  { term: t('about.availability'), value: pick(site.availability, locale) },
  {
    term: t('about.languages'),
    value: pick(site.languages, locale)
      .map((l) => `${l.name} (${l.level})`)
      .join(', '),
  },
];
---

<Section id="about" title={t('about.title')}>
  <div class="max-w-(--container-prose) space-y-5 text-lg">
    {pick(site.about, locale).map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <dl class="mt-12 grid gap-x-8 sm:grid-cols-2">
    {
      facts.map((fact) => (
        <div class="border-t border-line py-4">
          <dt class="font-display text-sm text-muted">{fact.term}</dt>
          <dd class="font-display mt-1 text-base font-medium text-ink">{fact.value}</dd>
        </div>
      ))
    }
  </dl>
</Section>
