---
/*
 * La Mancha at night, around Tarancón: Sierra de Altomira on the horizon,
 * a flat-topped ridge with windmills, and a ploughed field in front.
 * Decorative only. Coordinates live in a 1600×560 frame anchored to the bottom,
 * so narrow screens crop the sides and keep the mills (centred on x≈700) in view.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const W = 1600;
const H = 560;

// Mills stand on the ridge plateau (y = 411). [x, sail rotation in degrees, scale]
const mills: [number, number, number][] = [
  [548, 14, 0.92],
  [622, 38, 1],
  [704, 6, 1.05],
  [786, 52, 0.97],
  [858, 24, 0.9],
];

// Furrows converge on a vanishing point just above the field's horizon.
const vp = { x: 760, y: 468 };
const furrows = Array.from({ length: 29 }, (_, i) => -1400 + i * 150);
---

<svg
  class={className}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="sky-lift" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--color-night)" stop-opacity="0" />
      <stop offset="1" stop-color="var(--color-sky-low)" />
    </linearGradient>
    <clipPath id="field">
      <path d="M0 506 C 420 494 920 490 1600 500 V560 H0Z" />
    </clipPath>
    <symbol id="mill" overflow="visible">
      <path d="M-9 0 H9 L7 -38 H-7Z" fill="var(--color-mill)" />
      <path d="M-9.5 -37 H9.5 L0 -50Z" fill="var(--color-land-far)" />
    </symbol>
    <g id="sail" fill="none" stroke="var(--color-mill)" stroke-width="1.2">
      <path d="M0 0 V-36" />
      <rect x="0.8" y="-36" width="5" height="25" />
    </g>
  </defs>

  <rect x="0" y="0" width={W} height="440" fill="url(#sky-lift)" />

  <path
    fill="var(--color-land-far)"
    d="M0 402 C 150 384 260 362 420 374 S 700 350 860 366 S 1150 350 1300 368 S 1500 382 1600 372 V560 H0Z"
  />

  <path
    fill="var(--color-land-mid)"
    d="M0 462 C 140 452 260 440 380 424 L 470 412 L 900 410 L 950 420 C 1060 440 1180 446 1300 440 S 1480 452 1600 446 V560 H0Z"
  />

  {
    mills.map(([x, angle, s]) => (
      <g transform={`translate(${x} 411) scale(${s})`}>
        <use href="#mill" />
        <g transform="translate(0 -41)">
          {[0, 90, 180, 270].map((a) => (
            <use href="#sail" transform={`rotate(${angle + a})`} />
          ))}
        </g>
      </g>
    ))
  }

  <path fill="var(--color-land-near)" d="M0 506 C 420 494 920 490 1600 500 V560 H0Z" />
  <g clip-path="url(#field)" stroke="var(--color-line)" stroke-width="1">
    {furrows.map((x) => <line x1={vp.x} y1={vp.y} x2={x} y2={H} />)}
  </g>
</svg>
