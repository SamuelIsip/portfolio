---
/*
 * List of tools, in one of two layouts:
 * - `inline`: separated by slashes ("React / Spring Boot"), as in the reference.
 *   Used where the stack is a one-line footnote (projects).
 * - `grid`: aligned columns, two per row on phones, for lists meant to be scanned.
 * Items may carry a brand icon, drawn small and muted so it doesn't compete with
 * the single accent colour. Typography comes from `class`.
 */
import { brandIcon } from '@/lib/brand-icons';
import type { StackItem } from '@/types/content';

interface Props {
  items: (string | StackItem)[];
  layout?: 'inline' | 'grid';
  class?: string;
}

const { items, layout = 'inline', class: className } = Astro.props;
const entries = items.map((item) => {
  const { name, icon } = typeof item === 'string' ? { name: item, icon: undefined } : item;
  return { name, path: icon ? brandIcon(icon).path : undefined };
});
const isGrid = layout === 'grid';
---

<ul
  class:list={[
    'font-display',
    isGrid ? 'grid grid-cols-2 gap-x-6 gap-y-3 lg:grid-cols-3' : 'flex flex-wrap',
    className,
  ]}
>
  {
    entries.map(({ name, path }, i) => (
      <li class="inline-flex min-w-0 items-center">
        {path && (
          <svg
            viewBox="0 0 24 24"
            class="mr-[0.4em] size-[0.72em] shrink-0 fill-muted"
            aria-hidden="true"
            focusable="false"
          >
            <path d={path} />
          </svg>
        )}
        {name}
        {!isGrid && i < entries.length - 1 && (
          <span class="mx-[0.45em] font-normal text-line-strong" aria-hidden="true">
            /
          </span>
        )}
      </li>
    ))
  }
</ul>
