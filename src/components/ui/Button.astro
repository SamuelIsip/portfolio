---
import type { HTMLAttributes } from 'astro/types';

/*
 * primary: the one filled action per view.
 * quiet: a text link with a visible underline, for secondary actions.
 * Renders <a> when given an href, otherwise a <button>.
 */
type Props = { variant?: 'primary' | 'quiet' } & (
  | (HTMLAttributes<'a'> & { href: string })
  | (HTMLAttributes<'button'> & { href?: never })
);

const { href, variant = 'primary', class: className, ...rest } = Astro.props;

const variants = {
  primary:
    'rounded-sm bg-accent-strong px-5 py-3 text-white hover:bg-accent-deep active:bg-accent-deep disabled:cursor-progress disabled:bg-accent-deep',
  quiet:
    'py-3 text-ink underline decoration-line-strong decoration-1 underline-offset-[0.35em] hover:text-accent hover:decoration-accent',
};

const classes = [
  'font-display inline-flex items-center gap-2 text-sm font-semibold transition-colors duration-(--duration-fast)',
  variants[variant],
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes} {...(rest as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button class:list={classes} {...(rest as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}
