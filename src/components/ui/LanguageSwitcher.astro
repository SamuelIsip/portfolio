---
import { localeNames, localePath, locales, type Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const t = useTranslations(locale);
---

<ul class:list={['font-display flex items-center gap-1 text-xs font-semibold', className]} aria-label={t('a11y.language')}>
  {
    locales.map((l) => (
      <li>
        <a
          href={localePath(l)}
          hreflang={l}
          lang={l}
          aria-label={localeNames[l]}
          aria-current={l === locale ? 'true' : undefined}
          class="block rounded-sm px-2 py-1.5 tracking-(--tracking-wide) text-muted uppercase transition-colors duration-(--duration-fast) hover:text-ink aria-[current]:text-ink aria-[current]:underline aria-[current]:decoration-accent aria-[current]:decoration-2 aria-[current]:underline-offset-4"
        >
          {l}
        </a>
      </li>
    ))
  }
</ul>
